# --- Database ---
# Local PostgreSQL (fallback to SQLite if Postgres not available)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaint_system

# --- Groq LLM ---
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
# Spec-mandated default model. NOTE: Groq has decommissioned gemma2-9b-it, so
# at runtime the client transparently retries with llama-3.1-8b-instant when
# Groq rejects the configured model (see app/ai/llm.py _MODEL_FALLBACKS).
GROQ_MODEL=gemma2-9b-it
# Heavier reasoning model, optional
GROQ_HEAVY_MODEL=llama-3.3-70b-versatile

# --- App ---
APP_NAME=AIVOA Pharma Complaint System
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
